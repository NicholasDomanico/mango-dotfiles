// -*- mode: json -*-

{
	"layer": "top",
	"position": "top",
	"margin": "0px",

	"modules-left": [
        "custom/icon",
		"dwl/tags",
		"dwl/window"
	],

	"modules-center": [
	],

	"modules-right": [
		"mpris",
		"cava",
		"clock#2",
		"clock#1",
		"pulseaudio",
		"network",
        "bluetooth",
		"cpu",
		"battery",
		"custom/power"
	],


 "clock#1": {
	"format": "{:%I:%M %p} |",
    	"tooltip": false,

},
"clock#2": {
    	"format": "{:%a, %b %d}",
    	"tooltip-format": "<tt><small>{calendar}</small></tt>",
    	"calander": {
                    "mode"          : "year",
                    "mode-mon-col"  : 3,
                    "weeks-pos"     : "right",
                    "on-scroll"     : 1,
                    "format": {
                              "months":     "<span color='#ffead3'><b>{}</b></span>",
                              "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                              "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                              "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                              "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
                              }
    },
    	"actions":  {
                    "on-click-right": "mode",
                    "on-scroll-up": "tz_up",
                    "on-scroll-down": "tz_down",
                    "on-scroll-up": "shift_up",
                    "on-scroll-down": "shift_down"
                    }
  },
"clock#3": {
    	"format": "{:%m-%d}",
    	"tooltip": false
},

	"pulseaudio": {
		"format": "{icon}{volume}% |",
		"format-bluetooth": "{icon}  |",
		"format-muted": "  |",
		"format-icons": {
			"headphone": "  ",
			"default": [
                		" ",
				" ",
				" "
			]
		},
		"scroll-step": 5,
		"on-click": "pavucontrol",
        "tooltip": "true",
        "tooltip-format": "{desc}, at {volume}%"
	},
	"cpu": {
		"interval": 5,
		"format": " |"
	},
	"battery": {
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 15
		},
        "interval": 20,
        "tooltip-format-discharging": "Battery at {capacity}%\nEmpty in {time}\nBattery health at {health}%",
        "toltip-format-charging": "Battery at {capacity}%\nCharging, full in {time}",
            "format": "{icon} {capacity}% |",
            "format-icons": [
                "",
                "",
                "",
                "",
                ""
            ]
        },
  "network": {
        "format-wifi": "  |",
        "format-ethernet": " 	|",
        "tooltip-format-wifi": "{essid}\n {ifname} {ipaddr}/{cidr} via {gwaddr} \n Freq: {frequency}GHz, {signaldBm}dBm",
        "tooltip-format-ethernet": "{ifname {ipaddr}/{cidr} via {gwaddr}",
        "format-linked": "{ifname} (No IP)   |",
        "format-disconnected": "Disconnected ⚠ |",
        //"on-click": "kitty --title nmtui -- nmtui"
        "on-click": "kitty --title wlctl -- /home/nicholas/wlctl/target/release/wlctl"
    },
  "bluetooth": {
      "format-on": " |",
      "format-connected": "󰂱 |",
      "format-off": "󰂲 |",
      "format-disabled": "󰂲 |",
      "on-click": "kitty --title bluetui -- bluetui",
      "tooltip-format": "Bluetooth {controller_alias} {status}\n {device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}",
  },
  "custom/power": {
    "format": "{icon}",
	"tooltip": false,
    "format-icons": "⏻",
    "on-click": "~/mango-dots/scripts/bar/powermenu.sh"
    },
    "custom/icon": {
        "format": ""
    },
  "cava": {
        "framerate": 60,
        "autosens": 1,
        "bars": 6,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "sleep-timer": 1,
        "hide_on_silence": true,
        "method": "pipewire",
        "source": "auto",
        "stereo": false,
        "reverse": false,
        "bar_delimiter": 0,
        "monstercat": false,
        "waves": false,
        "noise_reduction": 0.10,
        "input_delay": 4,
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
        "actions": {
                   "on-click-right": "mode"
                   }
    },
"mpris": {
    "format": "{player_icon}{title} {status_icon}",
    "ellipsis": "...",
    "title-len": 30,
    "interval": 3,
    "player-icons": {
        "firefox": " ",
        "vlc": "󰕼 ",
    },
    "status-icons": {
        "paused": "󰏤 ",
        "playing": "󰐊 ",
    },
},

"dwl/window": {
    "max-length": 30,
},
  
}
